{
  "info": {
    "_postman_id": "booksphere-auth-service-collection",
    "name": "BookSphere - Auth Service",
    "description": "Postman collection for Auth Service.\n\nCovers:\n- Register\n- Login\n- Refresh token\n- Logout\n- Internal user snapshot for service-to-service lookups\n- Basic validation and security error cases\n- Via API Gateway and Direct Service checks\n\nRecommended run order:\n1. 00 - Auth API - Via Gateway\n2. 01 - Auth API - Direct Service\n3. 02 - Validation & Error Cases\n\nPrerequisites: Auth Service and API Gateway running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Auth API - Via Gateway",
      "description": "Public Auth APIs through API Gateway.",
      "item": [
        {
          "name": "POST Register Member - Via Gateway",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Registered Member\",\n  \"username\": \"postman.member.{{$timestamp}}\",\n  \"email\": \"postman.member.{{$timestamp}}@booksphere.com\",\n  \"password\": \"@1\",\n  \"phone\": \"0901234567\"\n}"
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/auth/register",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Register returns 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Register response has tokens', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.accessToken).to.be.a('string');",
                  "  pm.expect(body.data.refreshToken).to.be.a('string');",
                  "});",
                  "pm.environment.set('registeredAccessToken', body.data.accessToken);",
                  "pm.environment.set('registeredRefreshToken', body.data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Login ADMIN - Via Gateway",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/auth/login",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Login ADMIN returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Login ADMIN has ADMIN role', function () {",
                  "  pm.expect(body.data.user.roles).to.include('ADMIN');",
                  "});",
                  "pm.environment.set('accessTokenAdmin', body.data.accessToken);",
                  "pm.environment.set('refreshTokenAdmin', body.data.refreshToken);",
                  "pm.environment.set('adminUserId', body.data.user.id);"
                ]
              }
            }
          ]
        },
