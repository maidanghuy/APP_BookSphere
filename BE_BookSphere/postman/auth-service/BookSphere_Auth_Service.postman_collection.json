        {
          "name": "GET Internal User By ID - Direct Service",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authServiceBaseUrl}}/internal/users/{{memberUserId}}",
              "host": [
                "{{authServiceBaseUrl}}"
              ],
              "path": [
                "internal",
                "users",
                "{{memberUserId}}"
              ]
            },
            "description": "Service-to-service endpoint used by Borrow Service to enrich borrow responses with memberName and username."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Internal user returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Internal user payload has member snapshot fields', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.id).to.eql(Number(pm.environment.get('memberUserId')));",
                  "  pm.expect(body.data.fullName).to.be.a('string');",
                  "  pm.expect(body.data.username).to.eql(pm.environment.get('memberUsername'));",
                  "  pm.expect(body.data).to.have.property('isActive');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
