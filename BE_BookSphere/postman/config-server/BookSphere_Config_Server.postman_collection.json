    {
      "name": "02 - Shared Config",
      "item": [
        {
          "name": "Application Default Config",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Config application name is application', function () {",
                  "  pm.expect(body.name).to.eql('application');",
                  "});",
                  "pm.test('Default profile is included', function () {",
                  "  pm.expect(body.profiles).to.include(pm.environment.get('configProfile'));",
                  "});",
                  "pm.test('Property sources are returned', function () {",
                  "  pm.expect(body.propertySources).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{configServerBaseUrl}}/application/{{configProfile}}",
              "host": [
                "{{configServerBaseUrl}}"
              ],
              "path": [
                "application",
                "{{configProfile}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
